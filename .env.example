# Copy this file to .env and fill in your own Supabase project's values —
# see README.md → "Setting up Supabase" for exactly where to find these.
#
# Both must be prefixed EXPO_PUBLIC_ — that's what tells Expo to bake them
# into the app bundle (web, iOS, Android) at build time. Use the *anon
# (public)* key here, never the service_role/secret key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
